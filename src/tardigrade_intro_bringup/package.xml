  <version>0.1.0</version>
  <description>Provided simulation infrastructure for the Berkeley AUV controls intro.</description>
  <maintainer email="software@berkeleyauv.org">Berkeley AUV</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>rosgraph_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tardigrade_interfaces</depend>
  <exec_depend>tardigrade_bringup</exec_depend>

  <export>
